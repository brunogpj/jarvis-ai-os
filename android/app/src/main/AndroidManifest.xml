<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tela "Ouvindo": reconhecimento de fala dentro do app. Só liga o microfone depois do toque no orbe. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+: sem esta permissão a notificação fixa do serviço de fala não aparece (a fala toca do mesmo jeito). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Abrir app, link e navegação a partir do fundo (ordem do Jarvis): o Android 10+ só deixa com "exibir sobre outros apps". -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Detectar a abertura do Sisponto (única evidência de que o ponto foi batido): acesso especial a dados de uso, concedido pelo dono. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Telemetria (nome do Wi-Fi): o Android só entrega o SSID a quem tem localização. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Resolver o NOME dos apps cujas notificações o Jarvis lê. Sem isso o Android 11+ esconde o app (AppsFilter BLOCKED), o nome vira o pacote e o servidor descarta a notificação (Bíblia, 10/11). App de uso próprio, instalado por sideload. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Cerca geográfica: registrar de novo depois de reiniciar o aparelho ou atualizar o app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 11+: enxergar o serviço de reconhecimento de fala instalado (o do Google). -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    </queries>

    <application
        android:name=".JarvisApp"
        android:allowBackup="false"
        android:label="Jarvis"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Captura de notificações (precisa do acesso a notificações, concedido pelo dono em Configurações). -->
        <service
            android:name=".NotificacaoService"
            android:exported="true"
            android:label="Jarvis"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Duas opções da notificação interativa do Jarvis (e o campo de texto do modo saldo). Não exportado. -->
        <receiver android:name=".AcaoInterativaReceiver" android:exported="false" />

        <!-- Botões Sim / Não / Desfaz das notificações da caderneta. Não exportado: só as notificações do próprio app chegam aqui. -->
        <receiver android:name=".AcaoNotificacao" android:exported="false" />

        <!-- Conversa por toque: janela transparente que chama o reconhecimento de fala do sistema. -->
        <activity
            android:name=".ConversaActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <!-- Assistente digital padrão (Configurações → Apps padrão → Assistente digital): botão de energia / gesto do assistente / "OK Jarvis" do sistema abrem a escuta. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Assistente digital: serviço, sessão e o reconhecedor que o cadastro exige (ver AssistenteVoz.kt). -->
        <service android:name=".JarvisVoiceInteractionService" android:exported="true"
            android:label="Jarvis" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/interacao_voz" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service android:name=".JarvisSessionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".JarvisReconhecedorVazio" android:exported="true"
            android:label="Jarvis" android:permission="android.permission.RECORD_AUDIO">
            <meta-data android:name="android.speech" android:resource="@xml/reconhecedor_vazio" />
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Cerca geográfica da casa (ver Geocerca.kt). O Google Play Services entrega a transição ao receptor; o BootReceiver registra de novo. -->
        <receiver android:name=".GeocercaReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Widget de conversa da tela inicial. -->
        <receiver android:name=".WidgetConversa" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_conversa" />
        </receiver>

        <!-- Ouvir de novo a última fala: segundo atalho das configurações rápidas. -->
        <service
            android:name=".RepetirTile"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="Ouvir de novo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Atalho nas configurações rápidas. -->
        <service
            android:name=".ConversaTile"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="Jarvis"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Recebe as ordens do Jarvis por push (FCM). Exportado só para o FCM, que entrega pelo filtro abaixo. -->
        <service
            android:name=".JarvisMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Toca a fala em primeiro plano: o Android 14 exige o tipo mediaPlayback e uma notificação fixa. -->
        <service
            android:name=".FalaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Modo viagem: GPS, velocidade e limite da via, em primeiro plano (tipo location). -->
        <service
            android:name=".ViagemService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
