<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de conversa: um toque abre a tela "Ouvindo" (ConversaActivity). Mesmas cores do app: fundo #131834, ciano #22d3d3. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- RemoteViews só aceita um conjunto fechado de classes: View comum dava "Class not allowed to be inflated" (widget quebrado em 11/11). -->
    <ImageView
        android:id="@+id/widget_orbe"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_orbe"
        android:contentDescription="Jarvis" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jarvis"
            android:textColor="#e8ebf7"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toque e fale"
            android:textColor="#9aa3c4"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
